import argparse
import json
from pathlib import Path

from datasets import load_dataset
from peft import LoraConfig, get_peft_model, TaskType
from transformers import AutoModelForCausalLM, AutoTokenizer, TrainingArguments, Trainer


def build_prompt(example):
    instruction = example.get("instruction", "")
    user_input = example.get("input", "")
    output = example.get("output", "")
    if user_input:
        return f"<s>[INST] {instruction}\n\n{user_input} [/INST] {output} </s>"
    return f"<s>[INST] {instruction} [/INST] {output} </s>"


def load_jsonl_dataset(path):
    data = []
    with open(path, "r", encoding="utf-8") as f:
        for line in f:
            line = line.strip()
            if not line:
                continue
            data.append(json.loads(line))
    return data


def train(args):
    tokenizer = AutoTokenizer.from_pretrained(args.model_name)
    if tokenizer.pad_token is None:
        tokenizer.pad_token = tokenizer.eos_token

    model = AutoModelForCausalLM.from_pretrained(
        args.model_name,
        device_map="auto",
        trust_remote_code=False,
    )

    config = LoraConfig(
        r=args.lora_r,
        lora_alpha=args.lora_alpha,
        target_modules=["q_proj", "k_proj", "v_proj", "o_proj"],
        lora_dropout=0.05,
        bias="none",
        task_type=TaskType.CAUSAL_LM,
    )
    model = get_peft_model(model, config)

    dataset_rows = load_jsonl_dataset(args.dataset)
    formatted = [{"text": build_prompt(row)} for row in dataset_rows]

    ds = load_dataset("json", data_files={"train": args.dataset})
    # dataset from json can be wrapped in a custom format for Trainer
    train_ds = ds["train"].map(lambda x: {"text": build_prompt(x)})

    trainer = Trainer(
        model=model,
        args=TrainingArguments(
            output_dir=args.output_dir,
            per_device_train_batch_size=args.batch_size,
            gradient_accumulation_steps=4,
            learning_rate=args.learning_rate,
            num_train_epochs=args.epochs,
            logging_steps=10,
            save_steps=200,
            fp16=False,
            bf16=False,
            report_to=[]
        ),
        train_dataset=train_ds,
        tokenizer=tokenizer,
    )

    trainer.train()
    trainer.save_model(args.output_dir)
    tokenizer.save_pretrained(args.output_dir)


def parse_args():
    parser = argparse.ArgumentParser(description="Fine-tune Quen AI with LoRA")
    parser.add_argument("--model_name", type=str, default="mistral-7b-instruct")
    parser.add_argument("--dataset", type=str, default="data/sample_multilingual.jsonl")
    parser.add_argument("--output_dir", type=str, default="outputs/quen_ai_lora")
    parser.add_argument("--epochs", type=int, default=3)
    parser.add_argument("--batch_size", type=int, default=4)
    parser.add_argument("--learning_rate", type=float, default=2e-4)
    parser.add_argument("--lora_r", type=int, default=8)
    parser.add_argument("--lora_alpha", type=int, default=16)
    return parser.parse_args()


if __name__ == "__main__":
    args = parse_args()
    train(args)
